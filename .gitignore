# PDF source documents — copyright concerns (한국 임상병리학회 점검표).
# Stored locally for reference but excluded from public/private git history.
# pdf/01~90 subdirectories are themselves embedded git repos (one per
# 분류) — exclude entirely; only top-level metadata/scripts are tracked.
pdf/*/
pdf/.claude/
pdf/__pycache__/

# autopus-adk is a separate git repo (sibling), not a submodule
autopus-adk/

# Autopus-ADK generated files
.claude/rules/autopus/
.claude/skills/autopus/
.claude/commands/auto.md
.claude/agents/autopus/
.codex/config.toml
.codex/skills/
.gemini/skills/autopus/
.opencode/
.agents/skills/
.agents/plugins/
.autopus/cache/
.autopus/design/imports/
.autopus/*-manifest.json
.autopus/context/
.autopus/plugins/
# Note: .autopus/specs/, .autopus/brainstorms/, .autopus/project/ are user-authored
# documents (per .claude/rules/autopus/doc-storage.md) and SHOULD be tracked.
.mcp.json
