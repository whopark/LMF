# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local: mongodb://127.0.0.1:27017/lab_accreditation
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lab_accreditation
MONGO_URI=mongodb://127.0.0.1:27017/lab_accreditation

# Anthropic API (for LLM features)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=300
LLM_RATE_LIMIT_PER_MIN=20

# API Authentication (required for write operations)
API_KEY=your-secure-api-key-here

# CORS Configuration (comma-separated origins)
# Local: http://localhost:5000,http://localhost:5173
# Production: https://whopark.github.io,https://your-backend.onrender.com
CORS_ORIGINS=http://localhost:5000,http://localhost:5173
