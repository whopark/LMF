{
  "name": "lab-accreditation-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://whopark.github.io/LMF/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:gh": "vite build --base=/LMF/",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "predeploy": "npm run build:gh",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "axios": "^1.8.1",
    "framer-motion": "^12.4.10",
    "lucide-react": "^0.479.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.5",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
